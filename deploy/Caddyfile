# Point your domain's A record at this machine, then `docker compose up -d`.
# Caddy fetches and renews the TLS certificate on its own.
{$GROUPS_DOMAIN} {
	encode zstd gzip

	# Clip uploads can be a few hundred megabytes on a slow phone connection.
	request_body {
		max_size 256MB
	}

	reverse_proxy groups:8080 {
		# Do not buffer: the live event stream has to arrive as it happens.
		# Caddy's default upstream timeouts are unlimited, which is what a
		# long-lived stream and a slow upload both need — so nothing else here.
		flush_interval -1
	}
}
