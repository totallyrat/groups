# The domain Caddy should get a certificate for (docker compose only).
# A free DuckDNS subdomain works fine.
GROUPS_DOMAIN=groups.example.com

# Where the SQLite database and the video files live.
DATA_DIR=./data

PORT=8080
HOST=0.0.0.0

# Web Push identity. Generate a pair with `npm run keys`.
# Leave these unset and the server generates a pair into DATA_DIR/vapid.json,
# which is fine for a single self-hosted instance.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optionally restrict which web origins may call the API, e.g. your Pages site.
# Leave empty to allow any: cross-origin requests never carry the session
# cookie, so an arbitrary origin gains nothing.
ALLOWED_ORIGINS=

# Set to 1 only for plain-HTTP local development (session cookie without Secure).
INSECURE_COOKIES=0

# LOG_REQUESTS=1
